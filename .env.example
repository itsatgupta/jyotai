DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_astrologer

APP_NAME="AI Astrologer API"
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_DEBUG=false
# JSON array of exact deployed frontend origins; leave empty for local Vite proxy development.
CORS_ALLOWED_ORIGINS=[]

# Server-only Geoapify key for birthplace autocomplete. Never use a VITE_* variable.
GEOAPIFY_API_KEY=

LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen

ASTROLOGY_TRADITION=vedic
ZODIAC=sidereal
AYANAMSA=lahiri
HOUSE_SYSTEM=whole_sign
DASHA_SYSTEM=vimshottari
